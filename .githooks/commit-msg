#!/bin/sh
# SemVer: atualiza APP_VERSION em app.js ANTES de o commit ser criado.
# Usa o hook commit-msg porque a mensagem proposta só está disponível em "$1".
# Cálculo idêntico ao do post-commit → mesma tag/version bump.
#   BREAKING CHANGE ou !:  → MAJOR  (vX.0.0)
#   feat:                  → MINOR  (v0.X.0)
#   fix:, refactor:, etc   → PATCH  (v0.0.X)

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0")
VERSION=${LAST_TAG#v}

MAJOR=$(echo "$VERSION" | cut -d. -f1)
MINOR=$(echo "$VERSION" | cut -d. -f2)
PATCH=$(echo "$VERSION" | cut -d. -f3)
PATCH=$(echo "$PATCH" | sed 's/[^0-9].*//')
MAJOR=${MAJOR:-0}
MINOR=${MINOR:-0}
PATCH=${PATCH:-0}

COMMIT_MSG=$(sed -n '1p' "$MSG_FILE")
COMMIT_BODY=$(cat "$MSG_FILE")

BUMP="patch"
if echo "$COMMIT_MSG" | grep -qi "BREAKING CHANGE" || \
   echo "$COMMIT_BODY" | grep -qi "BREAKING CHANGE" || \
   echo "$COMMIT_MSG" | grep -q "!:"; then
  BUMP="major"
elif echo "$COMMIT_MSG" | grep -qi "^feat:"; then
  BUMP="minor"
fi

case "$BUMP" in
  major)
    MAJOR=$((MAJOR + 1))
    MINOR=0
    PATCH=0
    ;;
  minor)
    MINOR=$((MINOR + 1))
    PATCH=0
    ;;
  *)
    PATCH=$((PATCH + 1))
    ;;
esac

while true; do
  NEW_TAG="v$MAJOR.$MINOR.$PATCH"
  if ! git rev-parse "$NEW_TAG" >/dev/null 2>&1; then
    break
  fi
  PATCH=$((PATCH + 1))
done

NEW_VERSION_WITHOUT_V=${NEW_TAG#v}
if sed -i "s/const APP_VERSION = \".*\";/const APP_VERSION = \"${NEW_VERSION_WITHOUT_V}\";/g" app.js; then
  echo "commit-msg: APP_VERSION -> ${NEW_VERSION_WITHOUT_V}"
  git add app.js
else
  echo "commit-msg: Failed to update APP_VERSION in app.js"
  exit 1
fi
