#!/bin/sh
# Auto-sync APP_VERSION in app.js with the latest git tag before each commit

APP_FILE="app.js"
LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0")
VERSION=${LAST_TAG#v}

CURRENT_VERSION=$(grep -o 'const APP_VERSION = "[^"]*"' "$APP_FILE" | head -1 | cut -d'"' -f2)

if [ "$CURRENT_VERSION" != "$VERSION" ]; then
  sed -i "s/const APP_VERSION = \"[^\"]*\"/const APP_VERSION = \"${VERSION}\"/" "$APP_FILE"
  git add "$APP_FILE"
  echo "pre-commit: APP_VERSION updated ${CURRENT_VERSION} → ${VERSION}"
fi